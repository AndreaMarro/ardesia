#!/bin/bash
# pre-commit hook: blocco >= N literal in test assert lines
# Pattern: assert.*>= \d+ in test files where == is possible
# BUG: `>=` su conteggi deterministici fa passare test che dovrebbero fallire
# (pattern 3x in RETRO #4, #6, #7, #8)

echo "check-no-gte-literal: controlla test per >= su conteggi deterministici..."

violations=0
while IFS=: read -r file line content; do
  # Salta test che usano >= su valori non deterministici (baseline, timestamp, ecc.)
  # Salta fixture/template file
  case "$content" in
    *"gate_passed"*) continue ;;
    *"baseline"*) continue ;;
    *"delta"*) continue ;;
    *"timestamp"*) continue ;;
    *"cost_"*) continue ;;
    *"len("*")"*) ;;
    *) continue ;;
  esac
  echo "  WARN: $file:$line — $content"
  violations=$((violations + 1))
done < <(grep -rnE '^\s+assert .*>= \d+' tests/ 2>/dev/null || true)

if [ "$violations" -gt 0 ]; then
  echo "  -> $violations warning(s). Use == on deterministic counts."
fi

exit 0  # soft warning for now (non-blocking)
