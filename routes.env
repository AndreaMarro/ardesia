# Ardesia — ROUTES (ruolo -> scala modelli, il primo ACCESSIBILE vince).
# Fonte di verita unica del dosaggio modelli. Override dinamico (Telegram/malfunzione):
#   ~/.ardesia-routes.override  (sourced DOPO questo file -> vince)
# Ruoli (spec Andrea 13/06):
#   BRAIN     = pianificatore/progettista/scrittore-skill/corteccia (fable; opus se giu)
#   BUILDER   = sviluppatore principale (OPUS multiagente; fable solo su task taggata [FABLE])
#   RESEARCH  = ricercatore principale multiagente (opus; fable)
#   REVIEW    = revisore decorrelato free-first cross-family (codex->gemini->kimi->claude)
#   ADVERSARIAL = red-team HERMES-2 (kimi)
#   AUDIT     = audit 2x/g ultracode che PUO modificare tutto (fable; opus se giu)
# NB: fable-5 attualmente INACCESSIBILE via token headless (lato Anthropic) -> le scale
#     cadono su opus-4-8 da sole. Quando fable torna, pick-build-model/route lo ripigliano.

ROUTE_BRAIN="claude-fable-5 claude-opus-4-8 claude-sonnet-4-6"
ROUTE_BUILDER="claude-opus-4-8 claude-sonnet-4-6"
ROUTE_BUILDER_FABLE="claude-fable-5 claude-opus-4-8 claude-sonnet-4-6"
ROUTE_RESEARCH="claude-opus-4-8 claude-fable-5"
ROUTE_REVIEW="codex gemini kimi claude-fable-5 claude-opus-4-8"
ROUTE_ADVERSARIAL="kimi"
ROUTE_AUDIT="claude-fable-5 claude-opus-4-8"
