{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elabtutor.school/schemas/standard-experiment-schema.json",
  "title": "ELAB Standard Experiment Schema v1.0",
  "description": "Runtime validation schema for ELAB experiments. Canonical 7-step structure per Tea standard_experiment_schema.json. PRINCIPIO ZERO + MORFISMO compliant.",
  "type": "object",
  "required": ["experiment_id", "metadata", "steps"],
  "properties": {
    "experiment_id": {
      "type": "string",
      "pattern": "^v[1-3]-(cap[0-9]+-esp[0-9]+|cap[0-9]+-[a-z]+|extra-[a-z-]+)",
      "description": "Canonical experiment ID. Format: v{volume}-cap{chapter}-esp{number} or v{volume}-cap{chapter}-{slug}"
    },
    "metadata": {
      "type": "object",
      "required": ["title", "volume", "chapter", "page"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120,
          "description": "Verbatim or close-verbatim title from the physical volume"
        },
        "volume": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "chapter": {
          "type": "integer",
          "minimum": 1
        },
        "chapter_title": {
          "type": "string"
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "description": "Page number in the physical printed volume"
        },
        "target_age": {
          "type": "string"
        },
        "duration_min": {
          "type": "integer",
          "minimum": 10,
          "maximum": 120
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "components_needed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "kit_id", "quantity"],
            "properties": {
              "name": { "type": "string" },
              "kit_id": {
                "type": "string",
                "pattern": "^omaric\\."
              },
              "quantity": { "type": "integer", "minimum": 1 },
              "color": { "type": "string" }
            }
          }
        }
      }
    },
    "steps": {
      "type": "object",
      "required": ["setup", "ipotesi", "costruzione", "misura", "variazione", "conclusione", "trasferimento"],
      "description": "All 7 pedagogical steps mandatory — even capstone experiments require trasferimento (with next_experiment_id: null)",
      "properties": {
        "setup": {
          "type": "object",
          "required": ["class_hook"],
          "properties": {
            "class_hook": {
              "type": "string",
              "maxLength": 200,
              "description": "Opening hook — must address 'Ragazzi' in plural"
            },
            "prerequisites": {
              "type": "array",
              "items": { "type": "string" }
            },
            "components_visible": {
              "type": "array",
              "items": { "type": "string" }
            },
            "duration_estimate_min": { "type": "integer" },
            "teacher_tip": { "type": "string" }
          }
        },
        "ipotesi": {
          "type": "object",
          "required": ["open_question"],
          "properties": {
            "open_question": {
              "type": "string",
              "description": "Plural question to the class"
            },
            "expected_student_hypotheses": {
              "type": "array",
              "minItems": 2,
              "maxItems": 5,
              "items": {
                "type": "object",
                "required": ["hypothesis", "is_correct", "validation_method"],
                "properties": {
                  "hypothesis": { "type": "string" },
                  "is_correct": { "type": "boolean" },
                  "validation_method": { "type": "string" }
                }
              }
            },
            "duration_estimate_min": { "type": "integer" }
          }
        },
        "costruzione": {
          "type": "object",
          "required": ["assembly_sequence", "kit_protagonista"],
          "properties": {
            "circuit_diagram_ref": { "type": "string" },
            "assembly_sequence": {
              "type": "array",
              "minItems": 3,
              "maxItems": 12,
              "items": {
                "type": "object",
                "required": ["order", "action", "component", "checkpoint"],
                "properties": {
                  "order": { "type": "integer", "minimum": 1 },
                  "action": { "type": "string" },
                  "component": { "type": "string" },
                  "checkpoint": { "type": "string" }
                }
              }
            },
            "common_mistakes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["mistake", "diagnosis", "pedagogy"],
                "properties": {
                  "mistake": { "type": "string" },
                  "diagnosis": { "type": "string" },
                  "pedagogy": { "type": "string" }
                }
              }
            },
            "kit_protagonista": {
              "type": "boolean",
              "const": true,
              "description": "Always true — kit fisico Omaric is ALWAYS protagonist (MORFISMO Sense 2)"
            },
            "duration_estimate_min": { "type": "integer" }
          }
        },
        "misura": {
          "type": "object",
          "required": ["observable", "measurement_tool"],
          "properties": {
            "observable": { "type": "string" },
            "measurement_tool": {
              "type": "string",
              "enum": ["multimetro", "monitor seriale", "LED visivo", "occhio", "oscilloscopio", "app", "voltmetro"]
            },
            "expected_values": { "type": "object" },
            "telemetry_events": {
              "type": "array",
              "items": { "type": "string" }
            },
            "duration_estimate_min": { "type": "integer" }
          }
        },
        "variazione": {
          "type": "object",
          "required": ["free_exploration_allowed"],
          "properties": {
            "suggested_variations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "object",
                "required": ["variation", "expected_outcome", "concept_explored"],
                "properties": {
                  "variation": { "type": "string" },
                  "expected_outcome": { "type": "string" },
                  "concept_explored": { "type": "string" }
                }
              }
            },
            "free_exploration_allowed": {
              "type": "boolean",
              "default": true
            },
            "duration_estimate_min": { "type": "integer" }
          }
        },
        "conclusione": {
          "type": "object",
          "required": ["concepts_learned", "summary"],
          "properties": {
            "concepts_learned": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "summary": {
              "type": "string",
              "maxLength": 250,
              "description": "Summary in plural 'Ragazzi' — max 60 words"
            },
            "vol_page_citation": {
              "type": "object",
              "required": ["volume", "page", "verbatim_text"],
              "properties": {
                "volume": { "type": "integer" },
                "page": { "type": "integer" },
                "verbatim_text": {
                  "type": "string",
                  "description": "Exact verbatim text from the physical volume page"
                }
              }
            },
            "analogy": {
              "type": "object",
              "required": ["kind", "text"],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["food", "sport", "nature", "city", "music", "games", "body", "transport"]
                },
                "text": { "type": "string" }
              }
            },
            "duration_estimate_min": { "type": "integer" }
          }
        },
        "trasferimento": {
          "type": "object",
          "required": ["cliffhanger", "next_experiment_id"],
          "description": "Bridge to next experiment. ALL experiments including capstone must have this step. Capstone: next_experiment_id = null.",
          "properties": {
            "cliffhanger": {
              "type": "string",
              "maxLength": 200,
              "description": "Transition text to next experiment. PRINCIPIO ZERO: must start with or contain 'Ragazzi' in plural. Cite Vol.X pag.Y when applicable."
            },
            "next_experiment_id": {
              "oneOf": [
                { "type": "string", "pattern": "^v[1-3]-(cap[0-9]+-esp[0-9]+|cap[0-9]+-[a-z]+|extra-[a-z-]+)" },
                { "type": "null" }
              ],
              "description": "ID of next experiment in chapter/volume chain. null = terminal (end of volume or standalone)"
            },
            "concept_generalization": {
              "type": "string",
              "description": "How this experiment's concept generalizes to real-world applications (IoT, robotics, etc.)"
            },
            "is_capstone": {
              "type": "boolean",
              "default": false,
              "description": "True for chapter/volume capstone projects"
            },
            "duration_estimate_min": { "type": "integer" }
          }
        }
      }
    },
    "principio_zero_compliance": {
      "type": "object",
      "description": "PRINCIPIO ZERO v3 runtime compliance tracker. 12 rules, all must be true.",
      "properties": {
        "pz_v3_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "rules_passed": {
          "type": "object",
          "properties": {
            "plurale_ragazzi": { "type": "boolean" },
            "no_imperative_to_teacher": { "type": "boolean" },
            "kit_omaric_protagonista": { "type": "boolean" },
            "verbatim_book_citation": { "type": "boolean" },
            "max_60_words_per_text": { "type": "boolean" },
            "elab_palette_only": { "type": "boolean" },
            "no_galileo_name": { "type": "boolean" },
            "all_7_steps_present": { "type": "boolean" },
            "components_canonical": { "type": "boolean" },
            "analogy_required": { "type": "boolean" },
            "concepts_learned_tagged": { "type": "boolean" },
            "duration_within_class_period": { "type": "boolean" }
          }
        }
      }
    },
    "fumetto_mapping": {
      "type": "object",
      "description": "Mapping of 7 pedagogical steps to 6 comic strip vignettes",
      "properties": {
        "setup": { "type": "string", "const": "vignetta_1_problema" },
        "ipotesi": { "type": "string", "const": "vignetta_2_ipotesi" },
        "costruzione_misura": { "type": "string", "const": "vignetta_3_errore_o_costruzione" },
        "click_pedagogico": { "type": "string", "const": "vignetta_4_click" },
        "conclusione": { "type": "string", "const": "vignetta_5_successo" },
        "trasferimento": { "type": "string", "const": "vignetta_6_ponte" }
      }
    }
  }
}
