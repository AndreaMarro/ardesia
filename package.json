{
  "name": "elab-builder",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/add-signatures.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:breaknano:systematic": "vitest run tests/unit/breaknano.physical.test.js tests/unit/volume3.connections.test.js tests/unit/nanoR4Board.smoke.test.jsx",
    "test:ci": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "test:e2e": "npx playwright test --config tests/e2e/playwright.config.js",
    "test:e2e:smoke": "npx playwright test --config tests/e2e/playwright.config.js tests/e2e/01-homepage-load.spec.js tests/e2e/02-simulator-open.spec.js tests/e2e/10-deploy-verify.spec.js",
    "test:harness-real": "ELAB_PROD_URL=https://elab-tutor-git-e2e-bypass-preview-andreas-projects-6d4e9791.vercel.app npx playwright test --config tests/e2e/playwright.harness-real.config.js",
    "test:all": "npx vitest run && npx playwright test --config tests/e2e/playwright.config.js",
    "gate": "bash scripts/anti-regression-gate.sh",
    "gate:quick": "bash scripts/quick-regression-check.sh",
    "audit:honesty": "bash scripts/honesty-audit.sh",
    "sync-experiment-registry": "node scripts/sync-experiment-registry.mjs",
    "sync-experiment-registry:list": "node scripts/sync-experiment-registry.mjs --list",
    "postinstall": "node scripts/patch-blockly.js"
  },
  "keywords": [],
  "author": "Andrea Marro",
