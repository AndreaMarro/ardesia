# ELAB Builder — Required Environment Variables
# Copy to .env and fill in values
# All VITE_ prefixed vars are exposed to the client bundle by Vite.

# Galileo Chat AI webhook (n8n)
VITE_N8N_CHAT_URL=

# Admin CRUD webhook (n8n → Notion)
VITE_ADMIN_WEBHOOK=

# License verification webhook (n8n → Notion)
VITE_N8N_LICENSE_URL=

# Analytics webhook (n8n — simulator lifecycle events)
VITE_ANALYTICS_WEBHOOK=https://andreamarro.app.n8n.cloud/webhook/elab-simulator-analytics

# Nanobot V2 (Supabase Edge Functions — replaces Render nanobot)
# VITE_NANOBOT_URL=https://your-project.supabase.co/functions/v1/unlim-chat
# Legacy: VITE_NANOBOT_URL=https://elab-galileo.onrender.com

# Optional: standalone compile server URL
# VITE_COMPILE_URL=

# Optional: n8n compile webhook fallback
# VITE_N8N_COMPILE_URL=

# Optional: local dev API
# VITE_LOCAL_API_URL=
# VITE_LOCAL_COMPILE_URL=

# Optional: API timeout in ms (default: 30000)
# VITE_API_TIMEOUT=30000

# Data Server (backend EU per sync studenti + Teacher Dashboard)
# VITE_DATA_SERVER_URL=https://elab-data.onrender.com

# Auth Server URL (Netlify Functions)
# VITE_AUTH_URL=

# Optional: HMAC session secret (auto-generated per session if not set)
# VITE_SESSION_SECRET=

# Supabase (student sessions, teacher dashboard, nudges, progress sync)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Iter 29 Agent T tech-debt audit fix — 3 vars missing prior (.env real had them, .env.example silent)
# Supabase Edge Function service key (server-side privileged, GUARD: never expose client bundle)
# VITE_SUPABASE_EDGE_KEY=

# n8n compile webhook URL (Arduino compilation backend Hostinger)
# VITE_COMPILE_WEBHOOK_URL=https://n8n.srv1022317.hstgr.cloud/compile

# ELAB API key (X-Elab-Api-Key header iter 11 PATCH B + Edge unlim-chat auth gate)
# CRITICAL: rotated iter 32 commit be93d8d
# VITE_ELAB_API_KEY=
