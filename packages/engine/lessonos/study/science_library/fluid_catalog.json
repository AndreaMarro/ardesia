    {
      "id": "manometer",
      "capabilityId": "manometer-lab-v1",
      "title": "Pressione, densità e manometri",
      "objectiveIds": [
        "U3-02.06"
      ],
      "objective": "Leggere una differenza di livello come differenza di pressione e conservarne il segno.",
      "prediction": "Se inverti la differenza di livello, che cosa succede al segno di Δp?",
      "formula": "p₁ − p₂ = ρ g Δh",
      "assumptions": [
        "Liquido manometrico incomprimibile in quiete e densità uniforme.",
        "Δh è quota del livello sul ramo 2 meno quota sul ramo 1; p₁−p₂ ha lo stesso segno.",
        "Il modello non descrive capillarità, gas compressi o oscillazioni della colonna."
      ],
      "parameters": [
        {
          "key": "density",
          "label": "Densità",
          "unit": "kg/m³",
          "default": 1000,
          "min": 100,
          "max": 14000,
          "step": 10
        },
        {
          "key": "gravity",
          "label": "Accelerazione di gravità",
          "unit": "m/s²",
          "default": 9.81,
          "min": 0.1,
          "max": 25,
          "step": 0.01
        },
        {
          "key": "heightDifference",
          "label": "Differenza di livello Δh",
          "unit": "m",
          "default": 0.2,
          "min": -1,
          "max": 1,
          "step": 0.01
        }
      ],
      "threeD": false,
      "provenance": [
        {
          "source": "Ardesia — modelli analitici originali, 2026-10-28",
