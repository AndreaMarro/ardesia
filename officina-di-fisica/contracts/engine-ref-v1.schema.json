{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "engine-ref-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "maxLength": 32
    }
  }
}
