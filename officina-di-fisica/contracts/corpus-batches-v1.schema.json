{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/AndreaMarro/ardesia/officina-di-fisica/corpus-batches-v1",
  "type":"object","additionalProperties":false,"required":["schemaVersion","batches"],
  "properties":{
    "schemaVersion":{"const":"1.0.0"},
    "acceptanceWithdrawals":{"type":"object","additionalProperties":false,"required":["path","sha256"],
      "properties":{
        "path":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
        "sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
      }
    },
    "batches":{"type":"array","minItems":1,"maxItems":1000,"items":{
      "type":"object","additionalProperties":false,"required":["id","verifier","questionIds"],
      "properties":{
        "id":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"},
        "verifier":{"type":"string","pattern":"^[a-z][a-z0-9_]*_verifier$"},
        "questionIds":{"type":"array","minItems":1,"maxItems":100,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"}}
      }
    }},
    "activityBatches":{"type":"array","maxItems":1000,"items":{
      "type":"object","additionalProperties":false,"required":["id","verifier","activityIds"],
      "properties":{
        "id":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"},
        "verifier":{"type":"string","pattern":"^[a-z][a-z0-9_]*_verifier$"},
        "activityIds":{"type":"array","minItems":1,"maxItems":100,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"}},
        "revisionPackage":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"}
      }
    }}
  }
}
