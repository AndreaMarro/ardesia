{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "papers",
    "choices",
    "completions",
    "options",
    "minutes",
    "wrongPenalty",
    "medicalScale"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "papers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "choices": {
      "type": "integer",
      "minimum": 0,
      "maximum": 150
    },
    "completions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 150
    },
    "options": {
      "type": "integer",
      "minimum": 2,
      "maximum": 8
    },
    "minutes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 480
      }
    },
    "wrongPenalty": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "medicalScale": {
      "type": "boolean"
    }
  }
}
