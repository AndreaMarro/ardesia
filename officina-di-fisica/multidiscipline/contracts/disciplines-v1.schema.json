{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contratti delle discipline e degli strumenti matematici",
  "$defs": {
    "step": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "body"
      ]
    },
    "option": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false
    },
    "card": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "route": {
          "type": "string"
        },
        "coursesCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "title",
        "summary",
        "route",
        "coursesCount"
      ]
    },
    "directory": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "disciplines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/card"
          }
        }
      },
      "required": [
        "schemaVersion",
        "disciplines"
      ]
    },
    "skill": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "title": {
          "type": "string"
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
          }
        }
      },
      "required": [
        "id",
        "title"
      ]
    },
    "outline": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "skillId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "title": {
          "type": "string"
        },
        "objective": {
          "type": "string"
        },
        "activityIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
          }
        }
      },
      "required": [
        "id",
        "skillId",
        "title",
        "objective",
        "activityIds"
      ]
    },
    "course": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "accessible": {
          "type": "boolean"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
          }
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outline"
          }
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
          }
        },
        "formulas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "orderKey": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "accessible",
        "skills",
        "units"
      ]
    },
    "exam": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "title": {
          "type": "string"
        },
        "activityIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
          }
        },
        "mode": {
          "const": "practice"
        }
      },
      "required": [
        "id",
        "title",
        "activityIds",
        "mode"
      ]
    },
    "catalog": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "fisica"
            },
            "title": {
              "type": "string"
            },
            "route": {
              "const": "percorsi"
            },
            "courses": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
                  },
                  "title": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "title"
                ]
              }
            }
          },
          "required": [
            "id",
            "title",
            "route",
            "courses"
          ]
        },
        {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
            },
            "title": {
              "type": "string"
            },
            "version": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
            },
            "status": {
              "enum": [
                "preview",
                "published"
              ]
            },
            "skills": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/skill"
              }
            },
            "courses": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/course"
              }
            },
            "syllabi": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
                  },
                  "title": {
                    "type": "string"
                  },
                  "skills": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
                    },
                    "uniqueItems": true
                  },
                  "courses": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
                    },
                    "uniqueItems": true
                  }
                },
                "required": [
                  "id",
                  "title"
                ]
              }
            },
            "exams": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/exam"
              }
            }
          },
          "required": [
            "schemaVersion",
            "id",
            "title",
            "version",
            "status",
            "skills",
            "courses",
            "syllabi",
            "exams"
          ]
        }
      ]
    },
    "activity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "kind": {
          "const": "quiz"
        },
        "skillId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "prompt": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "hintCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "kind",
        "skillId",
        "prompt",
        "options",
        "hintCount"
      ],
      "additionalProperties": false
    },
    "unit": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "courseId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "title": {
          "type": "string"
        },
        "skillId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "objective": {
          "type": "string"
        },
        "lesson": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "oral": {
          "type": "object",
          "properties": {
            "prompt": {
              "type": "string"
            },
            "solution": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "prompt",
            "solution"
          ]
        },
        "activities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/activity"
          }
        },
        "representation": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "courseId",
        "version",
        "title",
        "skillId",
        "objective",
        "lesson",
        "oral",
        "activities"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "exposures": {
          "type": "integer",
          "minimum": 0
        },
        "completions": {
          "type": "integer",
          "minimum": 0
        },
        "assisted": {
          "type": "integer",
          "minimum": 0
        },
        "independent": {
          "type": "integer",
          "minimum": 0
        },
        "retention": {
          "type": "integer",
          "minimum": 0
        },
        "transfer": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "dueAt": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "legacyTransfer": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "exposures",
        "completions",
        "assisted",
        "independent",
        "retention",
        "transfer",
        "errors",
        "dueAt"
      ]
    },
    "position": {
      "type": "object",
      "properties": {
        "unitId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "activityId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "unitId",
        "activityId"
      ]
    },
    "notebook": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "resume": {
          "anyOf": [
            {
              "$ref": "#/$defs/position"
            },
            {
              "type": "null"
            }
          ]
        },
        "next": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "unitId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
                },
                "activityId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reason": {
                  "type": "string"
                },
                "action": {
                  "enum": [
                    "practice",
                    "review-lesson"
                  ]
                },
                "reasonCode": {
                  "type": "string"
                },
                "freshEvidenceAvailable": {
                  "type": "boolean"
                },
                "prerequisite": {
                  "type": "boolean"
                },
                "limitation": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "missingPrerequisites": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
                  },
                  "uniqueItems": true
                }
              },
              "required": [
                "unitId",
                "activityId",
                "reason"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "skills": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/evidence"
          }
        },
        "policyVersion": {
          "type": "string"
        },
        "scope": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "syllabi",
                    "courses"
                  ]
                },
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "id",
                "title"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "version",
        "resume",
        "next",
        "skills"
      ]
    },
    "event": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
            },
            "version": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
            },
            "unitId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
            },
            "kind": {
              "const": "open"
            },
            "activityId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
            }
          },
          "required": [
            "requestId",
            "version",
            "unitId",
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
            },
            "version": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
            },
            "unitId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
            },
            "kind": {
              "const": "complete"
            }
          },
          "required": [
            "requestId",
            "version",
            "unitId",
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
            },
            "version": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
            },
            "unitId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
            },
            "kind": {
              "const": "hint"
            },
            "activityId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
            },
            "hintIndex": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "requestId",
            "version",
            "unitId",
            "kind",
            "activityId",
            "hintIndex"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
            },
            "version": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
            },
            "unitId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
            },
            "kind": {
              "const": "answer"
            },
            "activityId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
            },
            "optionId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
            }
          },
          "required": [
            "requestId",
            "version",
            "unitId",
            "kind",
            "activityId",
            "optionId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "receipt": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "open",
            "complete",
            "hint",
            "answer"
          ]
        },
        "unitId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "activityId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "hint": {
          "type": "string"
        },
        "correct": {
          "type": "boolean"
        },
        "assisted": {
          "type": "boolean"
        },
        "correctOptionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "solution": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "feedback": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "transfer": {
          "type": "object",
          "properties": {
            "prompt": {
              "type": "string"
            },
            "answer": {
              "type": "string"
            }
          },
          "required": [
            "prompt",
            "answer"
          ]
        },
        "evidence": {
          "type": "object",
          "properties": {
            "transfer": {
              "type": "boolean"
            },
            "retention": {
              "type": "boolean"
            }
          },
          "required": [
            "transfer",
            "retention"
          ]
        }
      },
      "required": [
        "kind",
        "unitId",
        "version"
      ]
    },
    "contextRequest": {
      "type": "object",
      "properties": {
        "unitId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "scopes": {
          "type": "array",
          "items": {
            "enum": [
              "objective",
              "prerequisites",
              "evidence"
            ]
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        }
      },
      "required": [
        "unitId",
        "version",
        "scopes"
      ],
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "cric/study-context/1"
        },
        "discipline": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "unitId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "objective": {
          "type": "string"
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "required": [
        "schema",
        "discipline",
        "unitId",
        "version"
      ],
      "additionalProperties": false
    },
    "comparison": {
      "type": "object",
      "properties": {
        "operation": {
          "enum": [
            "equivalent",
            "derivative",
            "primitive"
          ]
        },
        "expression": {
          "type": "string",
          "maxLength": 220
        },
        "candidate": {
          "type": "string",
          "maxLength": 220
        }
      },
      "required": [
        "operation",
        "expression",
        "candidate"
      ],
      "additionalProperties": false
    },
    "verdict": {
      "type": "object",
      "properties": {
        "verdict": {
          "enum": [
            "equivalent",
            "different",
            "different-domain",
            "undetermined"
          ]
        },
        "explanation": {
          "type": "string"
        }
      },
      "required": [
        "verdict",
        "explanation"
