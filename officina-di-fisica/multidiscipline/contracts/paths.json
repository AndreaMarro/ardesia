        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      },
      "parameters": [
        {
          "in": "path",
          "name": "discipline",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
          }
        },
        {
          "in": "path",
          "name": "unit",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
          }
        }
      ],
      "security": [
        {
          "session": []
        }
      ]
    }
  },
