{
  "/v1/disciplines": {
    "get": {
      "summary": "Scopri le materie installate",
      "responses": {
        "200": {
          "description": "Risultato",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "/api/v1/schemas/disciplines-v1.schema.json#/$defs/directory"
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      },
      "parameters": []
    }
  },
  "/v1/disciplines/{discipline}": {
    "get": {
      "summary": "Consulta programmi, microcorsi e prerequisiti",
      "responses": {
        "200": {
          "description": "Risultato",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "/api/v1/schemas/disciplines-v1.schema.json#/$defs/catalog"
              }
            }
          }
        },
        "default": {
          "$ref": "#/components/responses/Problem"
        }
      },
      "parameters": [
        {
          "in": "path",
          "name": "discipline",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
          }
        }
      ]
    }
  },
  "/v1/disciplines/{discipline}/units/{unit}": {
    "get": {
      "summary": "Apri una lezione nella tua edizione",
