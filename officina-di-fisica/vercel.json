{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": [
    "dub1"
  ],
  "buildCommand": "python3 tools/pubblica_statici.py",
  "outputDirectory": "public",
  "installCommand": "node --version",
  "functions": {
    "api/index.py": {
      "maxDuration": 180,
      "includeFiles": "{multidiscipline/**,server/**,content/**,contracts/**,policies/**,migrations/**,static/**,materials/**,extensions/**,tools/inventario.py}"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "same-origin",
        "Content-Security-Policy": "default-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; form-action 'self'"
      },
      "continue": true
    },
    {
      "src": "/(?:api|asset|download|figures)/.*",
      "dest": "/api/index.py"
    },
    {
      "src": "/$",
      "dest": "/multidiscipline/index.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
