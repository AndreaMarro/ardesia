1.53,0],"text":"Sorgente","c":3484994},{"kind":"label","p":[2.55,1.6,0],"text":"Ricevitore","c":3484994}],"pilot":null,"stateMeasurementScope":"Exact source replay from observed controls/interaction, not private GPU-state introspection","actualRenderer":"3D interattivo","canvas":{"width":294,"height":340},"legend":"Sorgente ocra · fronti emessi · ricevitore o riflettore. La freccia della pressione è separata dal ricevitore. Nella prova di eco, la sfera ocra a sinistra rappresenta sorgente e microfono; lo schermo all’estremità destra è il riflettore. La freccia verde indica l’andata verso lo schermo; la viola indica il ritorno al microfono. La piccola sfera viola animata rappresenta l’impulso: arriva allo schermo, si riflette e ritorna alla sorgente. Le due frecce hanno quote e spostamenti laterali diversi solo per renderle distinguibili anche dall’alto: il tragitto fisico è lo stesso, percorso in versi opposti, con uguale lunghezza in andata e ritorno.","legendLayout":{"visible":true,"width":265,"scrollWidth":265},"readings":"Mezzo di propagazioneAcciaio Tempo su 150 m30 msVariazione dal riferimento-70 msCammino del suono0 m","guide":{"step-title":"Esegui la misura","explain":"Regola «Mezzo di propagazione» e confronta la scena con il punto segnato sul grafico. Parti da Acqua, poi prova Acciaio.","equation":"Mezzo di propagazione = Acciaio · Tempo su 150 m = 30 ms"},"clockReadout":"0","svg":null,"fullGlyphAcceptance":"NOT_GRANTED; raw primitives/group transforms and native32facet source are preserved for independent checks","labels":[{"kind":"label","p":[-0.48,1.53,0],"text":"Sorgente","c":3484994,"center":{"x":129.57777777777778,"y":148.94814814814814,"depth":-0.7208604302151075},"textureWidth":215,"box":{"x":129.57777777777778,"y":148.94814814814814,"w":63.23529411764706,"h":20}},{"kind":"label","p":[2.55,1.6,0],"text":"Ricevitore","c":3484994,"center":{"x":239.55555555555557,"y":146.4074074074074,"depth":-0.7208604302151075},"textureWidth":236,"box":{"x":239.5555