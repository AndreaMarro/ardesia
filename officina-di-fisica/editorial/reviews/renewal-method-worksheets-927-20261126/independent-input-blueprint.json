          ],
          "stage": null,
          "independentInput": "Dividi per rho · g"
        },
        {
          "kind": "expression",
          "prompt": "Scrivi il membro che equivale a h usando p0, p, rho, g.",
          "options": null,
          "stage": null,
          "independentInput": "(p-p0)/(rho*g)"
        },
        {
          "kind": "number",
          "prompt": "Converti in pascal e sostituisci. A quanti metri sei?",
          "options": null,
          "stage": null,
          "independentInput": "3"
