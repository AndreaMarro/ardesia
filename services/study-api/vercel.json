{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "installCommand": "uv sync --frozen --no-dev",
  "buildCommand": "python3 build_shared_core.py",
  "outputDirectory": null,
  "functions": {
    "app.py": {
      "includeFiles": "_core/**",
      "excludeFiles": "{tests/**,**/__pycache__/**,**/*.pyc}"
    }
  },
  "git": {
    "deploymentEnabled": false
  }
}
