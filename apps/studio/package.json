{
  "name": "studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run --project=unit --passWithNoTests",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "shots": "node scripts/shots.mjs",
    "e2e": "playwright test",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev --port 6006 --no-open",
    "storybook:build": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build --output-dir dist/storybook",
    "storybook:test": "STORYBOOK_DISABLE_TELEMETRY=1 vitest run --project=storybook"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "jszip": "^3.10.1",
    "mathjax-full": "^3.2.1",
    "mathlive": "^0.110.0",
    "pdfjs-dist": "^6.0.227",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.1",
    "@sentry/react": "10.66.0",
    "@sentry/vite-plugin": "5.4.0",
    "@storybook/addon-a11y": "10.3.6",
    "@storybook/addon-vitest": "10.3.6",
    "@storybook/react-vite": "10.3.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "4.1.10",
    "chromatic": "18.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "playwright": "1.61.1",
    "storybook": "10.3.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@sentry/bundler-plugins": "10.66.0",
    "@sentry/cli": "2.58.6",
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.0.9"
    },
    "@mermaid-js/parser": "1.2.0",
    "dompurify": "3.4.11",
    "esbuild": "0.28.1",
    "lodash-es": "4.18.1",
    "nanoid": "3.3.12",
    "undici": "7.28.0"
  }
}
