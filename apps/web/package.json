{
  "name": "@ardesia/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:public": "python3 ../../bin/web/export_public_preview.py --check && python3 ../../bin/web/export_course_learning.py --check && tsc -b && vite build --config vite.public.config.ts",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:public": "playwright test --config playwright.public.config.ts"
  },
  "dependencies": {
    "@fullcalendar/react": "7.1.3",
    "@radix-ui/react-dialog": "1.3.1",
    "dompurify": "3.4.17",
    "mathlive": "0.111.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "temporal-polyfill": "1.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "jsdom": "29.1.1",
    "typescript": "6.0.2",
    "vite": "8.0.12",
    "vitest": "4.1.8"
  }
}
