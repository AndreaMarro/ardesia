      {
        "id": "collision-1d-v1",
        "version": 1,
        "implementationSha256": "dd1ffac3bdc46466b0bbead5902db4f63753ca17265f53d124771ac3630b2c78",
        "title": "Urto e bilancio di energia",
        "primaryOutput": {
          "label": "Velocità finale del corpo1",
          "unit": "m/s"
        },
        "explanation": [
          "La quantità di moto totale prima e dopo coincide se la risultante degli impulsi esterni è trascurabile.",
          "Il coefficiente e confronta velocità relativa di separazione e di avvicinamento. Per e=1 l’urto è elastico; per e=0 i due corpi hanno la stessa velocità finale.",
          "L’energia cinetica trasformata non è energia totale scomparsa. Il modello non descrive deformazioni o temperatura durante l’urto."
        ],
        "transfer": {
          "mass1": 1,
          "mass2": 1,
          "velocity1": 2,
          "velocity2": -1,
          "restitution": 1
        },
        "domain": "Urto istantaneo unidimensionale fra due corpi isolati: corpo1 a sinistra di corpo2, in avvicinamento u1>u2. Masse positive; coefficiente di restituzione 0≤e≤1. Quantità di moto conservata; energia cinetica conservata solo per e=1. Nessun attrito, forza esterna, rotazione, penetrazione o andamento temporale dell’urto.",
        "distribution": "BUNDLED_FIRST_PARTY",
        "editorialStatus": "DRAFT",
        "parameters": [
