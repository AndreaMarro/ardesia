{
  "browser": {
    "mode": "connect",
    "cdp_endpoint": "http://127.0.0.1:5359",
    "target_id": "7BB74F3B00FE8A0F92B21CD466FAD362"
  },
  "start_url": {
    "url": "http://127.0.0.1:5321/"
  },
  "environment": {
    "locale": "it-IT",
    "timezone": "Europe/Rome",
    "viewport": {
      "width": 1440,
      "height": 1000
    }
  },
  "actions": [
    {
      "step_id": "lab-visible",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": ".physics-lab"
      },
      "state": "visible",
      "timeout_ms": 15000
    },
    {
      "step_id": "predict-before-calculation",
      "action": "fill",
      "locator": {
        "kind": "role",
        "role": "textbox",
        "name": "La tua previsione"
      },
      "value": {
        "source": "literal",
        "value": "R6: con pressione fissata e raggio doppio prevedo portata sedici; con portata fissata pressione un sedicesimo."
      }
    },
    {
      "step_id": "double-radius",
      "action": "press",
      "locator": {
        "kind": "role",
        "role": "slider",
        "name": "Rapporto dei raggi"
      },
      "key": "End"
    },
    {
      "step_id": "commit-first-evaluation",
      "action": "click",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Metti alla prova"
      }
    },
    {
      "step_id": "flow-ratio-ready",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-testid=\"physics-ratio\"]:has-text(\"16\")"
      },
      "state": "visible",
      "timeout_ms": 15000
    },
    {
      "step_id": "change-boundary",
      "action": "select_option",
      "locator": {
        "kind": "role",
        "role": "combobox",
        "name": "Grandezza fissata"
      },
      "value": {
        "source": "literal",
        "value": "flow"
      }
    },
    {
      "step_id": "old-result-invalidated",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-testid=\"physics-ratio\"]"
      },
      "state": "detached",
      "timeout_ms": 15000
    },
    {
      "step_id": "commit-second-evaluation",
      "action": "click",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Metti alla prova"
      }
    },
    {
      "step_id": "pressure-ratio-ready",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-testid=\"physics-ratio\"]:has-text(\"0,0625\")"
      },
      "state": "visible",
      "timeout_ms": 15000
    }
  ],
  "capture": {
    "after_each_step": [
      "dom",
      "accessibility",
      "url"
    ],
    "at_end": [
      "dom",
      "accessibility",
      "screenshot",
      "url"
    ],
    "events": [
      "network",
      "page-errors"
    ],
    "network": {
      "response_body": true
    },
    "limits": {
      "max_network_body_bytes": 262144
    }
  }
}
