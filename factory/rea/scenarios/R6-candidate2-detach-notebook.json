{
  "browser": {
    "mode": "launch",
    "executable_path": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    "headless": true
  },
  "start_url": {
    "url": "http://127.0.0.1:5321/?view=classroom"
  },
  "environment": {
    "locale": "it-IT",
    "timezone": "Europe/Rome",
    "viewport": {
      "width": 1440,
      "height": 1000
    },
    "reduced_motion": "reduce",
    "service_workers": "block",
    "color_scheme": "light"
  },
  "actions": [
    {
      "step_id": "workspace-ready",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": ".source-board"
      },
      "state": "visible",
      "timeout_ms": 15000
    },
    {
      "step_id": "table-view",
      "action": "click",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Tavolo"
      },
      "timeout_ms": 15000
    },
    {
      "step_id": "detach-copy-only",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "article[data-instance-id=\"view-0e1fac34-519d-49fa-a058-5f407e383652\"] button.board-detach"
      },
      "timeout_ms": 15000
    },
    {
      "step_id": "copy-detached-from-draft",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "article[data-instance-id=\"view-0e1fac34-519d-49fa-a058-5f407e383652\"]"
      },
      "state": "detached",
      "timeout_ms": 15000
    },
    {
      "step_id": "dirty-layout-explicit",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-testid=\"board-save-state\"]:has-text(\"non salvate\")"
      },
      "state": "visible",
      "timeout_ms": 15000
    },
    {
      "step_id": "save-detached-layout",
      "action": "click",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Salva disposizione"
      },
      "timeout_ms": 15000
    },
    {
      "step_id": "detach-persisted",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-testid=\"board-save-state\"]:has-text(\"Disposizione salvata\")"
      },
      "state": "visible",
      "timeout_ms": 15000
    },
    {
      "step_id": "reopen-after-detach",
      "action": "goto",
      "destination": {
        "url": "http://127.0.0.1:5321/?view=classroom"
      },
      "wait_until": "domcontentloaded",
      "timeout_ms": 20000
    },
    {
      "step_id": "remaining-view-recovered",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "article[data-instance-id=\"view-081ebabe-8d18-431c-b604-e1bdcf888e71\"]:has-text(\"REA R0 — area\")"
      },
      "state": "visible",
      "timeout_ms": 15000
    },
    {
      "step_id": "copy-stays-detached",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "article[data-instance-id=\"view-0e1fac34-519d-49fa-a058-5f407e383652\"]"
      },
      "state": "detached",
      "timeout_ms": 15000
    },
    {
      "step_id": "canonical-source-still-in-library",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "aside.board-library li:has-text(\"REA R0 — area\")"
      },
      "state": "visible",
      "timeout_ms": 15000
    },
    {
      "step_id": "materials",
      "action": "click",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Materiali"
      },
      "timeout_ms": 15000
    },
    {
      "step_id": "portable-tutor-notebook",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "details.tutor-notebook summary"
      },
      "timeout_ms": 15000
    },
    {
      "step_id": "export",
      "action": "click",
      "locator": {
        "kind": "role",
        "role": "button",
        "name": "Esporta quaderno"
      },
      "timeout_ms": 15000
    },
    {
      "step_id": "export-receipt",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": ".study-notebook [role=\"status\"]:has-text(\"esportato\")"
      },
      "state": "visible",
      "timeout_ms": 15000
    }
  ],
  "capture": {
    "after_each_step": [
      "dom",
      "accessibility",
      "url"
    ],
    "at_end": [
      "dom",
      "accessibility",
      "screenshot",
      "url"
    ],
    "events": [
      "network",
      "page-errors"
    ],
    "limits": {
      "max_network_body_bytes": 8388608,
      "max_total_event_allocation_bytes": 67108864,
      "max_network_body_allocation_bytes": 33554432
    },
    "network": {
      "request_body": false,
      "response_body": true,
      "header_values": false
    }
  },
  "storage": {
    "cookies": [
      {
        "name": "study_session",
        "value": {
          "source": "secret",
          "secret_id": "r6-c2-session"
        },
        "destination": {
          "url": "http://127.0.0.1:5321/"
        },
        "http_only": true,
        "secure": false,
        "same_site": "Strict"
      }
    ]
  },
  "secrets": [
    {
      "secret_id": "r6-c2-session",
      "environment_variable": "ARDESIA_REA_R6_C2_SESSION"
    }
  ]
}