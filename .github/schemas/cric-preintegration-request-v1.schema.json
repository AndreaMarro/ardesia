{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "previewRunId",
    "previewHeadSha",
    "runtimeSha256",
    "registrySha256",
    "sourceRef",
    "cricRef",
    "expectedQuestionCount",
    "expectedActivityCount",
    "expectedQuestionDrafts",
    "expectedReviewedActivities",
    "scientificRefreshBatches",
    "protocolFiles",
    "producerWorkflow"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "previewRunId": {
      "type": "integer",
      "minimum": 1
    },
    "previewHeadSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "runtimeSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "registrySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceRef": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "cricRef": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "expectedQuestionCount": {
      "type": "integer",
      "minimum": 1
    },
    "expectedActivityCount": {
      "type": "integer",
      "minimum": 1
    },
    "expectedQuestionDrafts": {
      "type": "integer",
      "minimum": 0
    },
    "expectedReviewedActivities": {
      "type": "integer",
      "minimum": 0
    },
    "scientificRefreshBatches": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      }
    },
    "protocolFiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tests/corpus/browser-batches.mjs",
        "tests/corpus/browser-batches-resume.mjs",
        "tests/corpus/browser-drafts.mjs"
      ],
      "properties": {
        "tests/corpus/browser-batches.mjs": {
          "$ref": "#/$defs/sha"
        },
        "tests/corpus/browser-batches-resume.mjs": {
          "$ref": "#/$defs/sha"
        },
        "tests/corpus/browser-drafts.mjs": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "producerWorkflow": {
      "enum": [
        ".github/workflows/cric-preview-evidence.yml",
        ".github/workflows/cric-preintegration-evidence.yml"
      ]
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
