{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/vDevPreview/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "ELAB-TUTOR-PLACEHOLDER-UUID",
  "developer": {
    "name": "ELAB Tutor — Andrea Marro + Omaric Elettronica",
    "websiteUrl": "https://www.elabtutor.school",
    "privacyUrl": "https://www.elabtutor.school/privacy",
    "termsOfUseUrl": "https://www.elabtutor.school/terms",
    "mpnId": ""
  },
  "icons": {
    "color": "icon-192.png",
    "outline": "icon-32-outline.png"
  },
  "name": {
    "short": "ELAB Tutor",
    "full": "ELAB Tutor — Elettronica Arduino Scuole"
  },
  "description": {
    "short": "Tutor AI + simulatore Arduino per scuole italiane 8-14 anni",
    "full": "ELAB Tutor è un tutor educativo per elettronica e Arduino. Include kit fisico, 3 volumi cartacei e simulatore web interattivo proiettabile su LIM. Distribuito Microsoft Teams Tab per docenti scuole italiane Workspace 365 EDU."
  },
  "accentColor": "#1E4D8C",
  "configurableTabs": [
    {
      "configurationUrl": "https://www.elabtutor.school/teams/configure",
      "scopes": ["team", "groupChat"],
      "supportedTenantTypes": ["edu"],
      "context": ["channelTab", "privateChatTab", "meetingChatTab", "meetingDetailsTab", "meetingSidePanel", "meetingStage"]
    }
  ],
  "staticTabs": [
    {
      "entityId": "elab-lavagna",
      "name": "Lavagna ELAB",
      "contentUrl": "https://www.elabtutor.school/lavagna?platform=teams",
      "websiteUrl": "https://www.elabtutor.school/lavagna",
      "scopes": ["personal"],
      "context": ["personalTab"]
    },
    {
      "entityId": "elab-tutor",
      "name": "Tutor UNLIM",
      "contentUrl": "https://www.elabtutor.school/chatbot-only?platform=teams",
      "websiteUrl": "https://www.elabtutor.school/chatbot-only",
      "scopes": ["personal"],
      "context": ["personalTab"]
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": [
    "www.elabtutor.school",
    "elabtutor.school",
    "*.elabtutor.school"
  ],
  "showLoadingIndicator": true,
  "isFullScreen": false,
  "defaultBlockUntilAdminAction": false,
  "publisherDocsUrl": "https://www.elabtutor.school/teams/docs",
  "defaultGroupCapability": {
    "team": "tab",
    "groupchat": "tab"
  }
}
