{
  "git": { "deploymentEnabled": false },
  "framework": "vite",
  "installCommand": "npm --prefix apps/studio ci",
  "buildCommand": "npm --prefix apps/studio run build",
  "outputDirectory": "apps/studio/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
